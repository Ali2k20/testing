# ── Supabase (Project Settings → API) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of this app (used for the widget snippet, webhook URL and auth emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32 random bytes, base64 — encrypts WhatsApp access tokens at rest.
#   openssl rand -base64 32
ENCRYPTION_KEY=

# ── AI providers ──────────────────────────────────────────────────────────────
# Reasoning:      google (gemini-2.5-flash) | openai (gpt-4o)
AI_CHAT_PROVIDER=google
# Transcription:  groq (whisper-large-v3-turbo) | openai (whisper-1)
AI_TRANSCRIPTION_PROVIDER=groq
# Embeddings (must be 1536-d): openai (text-embedding-3-small) | google (gemini-embedding-001 @1536)
AI_EMBEDDING_PROVIDER=openai
# Optional model overrides
# AI_CHAT_MODEL=
# AI_TRANSCRIPTION_MODEL=
# AI_EMBEDDING_MODEL=

GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ── WhatsApp Cloud API (Meta app → WhatsApp → Configuration) ─────────────────
# Any string you choose; paste the same value as the webhook "Verify token".
WHATSAPP_VERIFY_TOKEN=
# Meta app → Settings → Basic → App secret. Used to verify X-Hub-Signature-256.
META_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v23.0
